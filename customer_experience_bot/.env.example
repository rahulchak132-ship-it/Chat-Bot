# ==============================================================================
# ENTERPRISE CUSTOMER EXPERIENCE (CX) CHATBOT CONFIGURATION
# ==============================================================================

# OpenAI API Key (Obtain from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model Selection (Recommended: gpt-4o-mini, gpt-4o, or gpt-3.5-turbo)
OPENAI_MODEL=gpt-4o-mini

# Corporate Branding & Identity
COMPANY_NAME=Apex Global Technologies & Systems
SUPPORT_EMAIL=support@apexglobal.com
SUPPORT_HOTLINE=+1 (800) 555-0199

# Database & Storage
DATABASE_PATH=data/cx_database.sqlite
UPLOAD_DIR=uploads

# System & Escalation Thresholds
SLA_BREACH_HOURS=48
CRITICAL_ESCALATION_EMAIL=escalations@apexglobal.com
LOG_LEVEL=INFO
